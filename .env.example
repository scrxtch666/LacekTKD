# Jediný .env pro celý projekt (docker compose) — zkopíruj do `.env`
# a doplň skutečné hodnoty. docker-compose.yml z něj čte proměnné jak
# pro kontejner s MySQL, tak (přes environment: u backendu) pro Node appku.

# --- MySQL (služba `db`) ---
DB_ROOT_PASSWORD=
DB_NAME=lacektkd
DB_USER=lacektkd
DB_PASS=

# --- Backend ---
PORT=3000
CORS_ORIGIN=

ACCES_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

MAP_API=

JWT_EXPIRES_IN=

GOOGLE_CALENDAR_ID=
